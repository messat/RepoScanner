<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (framework, nullable, usings, warnings) come from /Directory.Build.props -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic Host: configuration, dependency injection and logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- ValidateDataAnnotations(): checks [Required], [Range] etc. on options classes -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Plugs Serilog into the host as the logger behind ILogger<T> -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <!-- Serilog output to the console (stdout), which Container Apps collects -->
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- One JSON object per log line outside Development, for Log Analytics (ADR-028) -->
    <PackageReference Include="Serilog.Formatting.Compact" />
    <!-- NuGet's own version and range rules, for matching packages against advisories (#44, #45) -->
    <PackageReference Include="NuGet.Versioning" />
    <!-- IHttpClientFactory and the standard retry and timeout handler for nuget.org (#44) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- Roslyn: parses C# into a syntax tree for the code-pattern rules to walk (#49, ADR-018) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The storage queues the scan requests come from (#30) -->
    <PackageReference Include="Azure.Storage.Queues" />
    <!-- DefaultAzureCredential: signs in to the queues with the job's managed identity in Azure (#30, ADR-007) -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <!-- Lets the test project call internal members, such as Program.RunAsync -->
  <ItemGroup>
    <InternalsVisibleTo Include="RepoScanner.Scanner.Tests" />
  </ItemGroup>

  <!-- Copy the settings files next to the built app, where the host looks for them -->
  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Published images run as Production with every setting from environment variables, so the
         Development settings stay out of the published app (Issue 9 design, decision 4) -->
    <None Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Scanner uses Core's types and Data's database access -->
  <ItemGroup>
    <ProjectReference Include="..\RepoScanner.Core\RepoScanner.Core.csproj" />
    <ProjectReference Include="..\RepoScanner.Data\RepoScanner.Data.csproj" />
  </ItemGroup>

</Project>
