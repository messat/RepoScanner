# The scanner container's settings, read by docker run --env-file .env (README: Run in a container).
# Copy this file to .env, which git ignores, and replace each <...> with the real value.
# One NAME=value per line, with no quotes: Docker keeps quotes as part of the value.
Scanner__Queue__Name=scan-nightly
Scanner__Queue__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<azurite-account-key>;QueueEndpoint=http://host.docker.internal:10001/devstoreaccount1;
Scanner__AzureDevOps__OrganizationUrl=https://dev.azure.com/BlacklightInternalsMo
Scanner__AzureDevOps__Pat=<pat>
Scanner__Database__ConnectionString=Server=host.docker.internal,1433;Database=RepoScanner;User ID=repo_scanner_local;Password=<password>;Encrypt=True;TrustServerCertificate=True
