<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (framework, nullable, usings, warnings) come from /Directory.Build.props -->
  <PropertyGroup>
    <!-- Test projects are never published as NuGet packages -->
    <IsPackable>false</IsPackable>

    <!-- Coverage is still measured and reported for Data, but not enforced:
         the 80% target applies to Core and Scanner only (Definition of Done) -->
    <Threshold>0</Threshold>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets dotnet test discover and run the tests in this project -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The test framework: [Test], [TestFixture], Assert.That -->
    <PackageReference Include="NUnit" />
    <!-- Connects NUnit to dotnet test and Visual Studio Test Explorer -->
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Compile-time checks for common NUnit mistakes -->
    <PackageReference Include="NUnit.Analyzers" />
    <!-- Measures code coverage during dotnet test and fails the run below the threshold -->
    <PackageReference Include="coverlet.msbuild" />
    <!-- In-memory SQLite database: fast, no SQL Server needed, a new database for every test -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <!-- The project under test -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\RepoScanner.Data\RepoScanner.Data.csproj" />
  </ItemGroup>

</Project>
