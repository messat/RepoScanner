<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.59.0" /> <!-- used by Api and Worker -->
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.1" /> <!-- used by no project -->
    <PackageVersion Include="System.Text.Encodings.Web" Version="8.0.0" /> <!-- Worker overrides it -->
  </ItemGroup>
</Project>
